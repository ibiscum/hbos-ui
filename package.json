{
  "name": "hbos-ui",
  "version": "0.20.6",
  "description": "A modern Vue 3 web interface for HiFiBerryOS",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-expose": "vite --host",
    "dev-server": "vite --config vite.config.dev-server.ts",
    "dev-server-expose": "vite --host --config vite.config.dev-server.ts",
    "device": "vite --mode test-device",
    "device-expose": "vite --host --mode test-device",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "preview-expose": "vite preview --host",
    "build-only": "vite build",
    "type-check": "vue-tsc --build tsconfig.app.json tsconfig.node.json",
    "type-check:tests": "vue-tsc --build tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@vueuse/core": "^13.9.0",
    "apexcharts": "^5.16.0",
    "chart.js": "^4.5.1",
    "d3": "^7.9.0",
    "d3-graphviz": "^5.6.0",
    "pinia": "^3.0.4",
    "simple-statistics": "^7.9.3",
    "vue": "^3.5.40",
    "vue-audio-level-meter": "^1.1.8",
    "vue-chartjs": "^5.3.4",
    "vue-inline-svg": "^4.0.1",
    "vue-router": "^4.6.4",
    "vue3-apexcharts": "^1.11.1",
    "vue3-toastify": "^0.2.9"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/d3": "^7.4.3",
    "@types/d3-graphviz": "^2.6.10",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "~10.0.1",
    "happy-dom": "^20.11.1",
    "jiti": "^2.7.0",
    "npm-run-all2": "^7.0.2",
    "prettier": "3.5.3",
    "sass-embedded": "^1.100.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-remove-console": "^2.2.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.12"
  }
}
